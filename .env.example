# EpiScope environment template (PRV-1, ENG-1)
# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# Salt used to hash patient_id before any data enters the silver layer (PRV-1).
# Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
EPISCOPE_PATIENT_SALT=replace_me_with_a_64_character_hex_string

# Paths
EPISCOPE_PROJECT_ROOT=/content/drive/MyDrive/episcope-bd
EPISCOPE_DATA_ROOT=/content/episcope_data

# Generator parameters (Section 5.2: deterministic for a given seed)
EPISCOPE_SEED=20260101
EPISCOPE_SCALE_FACTOR=1.0

# Spark tuning (measured environment: 2 cores, 12.67 GB RAM)
EPISCOPE_SPARK_DRIVER_MEMORY=6g
EPISCOPE_SPARK_SHUFFLE_PARTITIONS=32
